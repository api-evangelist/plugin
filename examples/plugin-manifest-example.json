      "id": "claude.reviewChanges",
      "title": "Claude: Review Pending Changes"
    },
    {
      "type": "view",
      "id": "claude.sidebar",
      "title": "Claude"
    }
  ],
  "permissions": [
    "network",
    "storage",
    "clipboard"
  ],
  "categories": [
    "AI",
    "Programming Languages",
    "Snippets"
  ],
  "repository": "https://github.com/anthropic/claude-code",
  "homepage": "https://claude.com/code",
